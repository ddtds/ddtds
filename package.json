{
  "name": "ddtds",
  "version": "0.0.0",
  "private": true,
  "files": [
    "package.json"
  ],
  "type": "module",
  "scripts": {
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "dedupe": "pnpm dedupe",
    "dedupe:check": "pnpm dedupe --check",
    "lint": "oxlint . --max-warnings 0",
    "lint:fix": "oxlint . --fix",
    "analyze": "e18e-cli analyze",
    "prebench": "pnpm run build",
    "bench": "pnpm --filter @ddtds/benches bench",
    "typecheck": "pnpm -r run typecheck",
    "build": "tsdown",
    "pretest": "pnpm run build",
    "test": "vitest run",
    "test:packages": "pnpm --filter './packages/*' run test",
    "test:examples": "pnpm --filter '@ddtds/example-*' test",
    "test:update-snapshots": "vitest run -u",
    "test:vitest": "vitest run --coverage --project '!@ddtds/node-test' && pnpm --filter @ddtds/angular-greet test",
    "test:node": "pnpm --filter '...@ddtds/node-test' test",
    "test:coverage": "vitest run --coverage",
    "pretest:coverage": "pnpm run build",
    "knip": "knip --treat-config-hints-as-errors",
    "publint": "pnpm --filter './packages/*' exec publint --strict",
    "sherif": "sherif --fail-on-warnings",
    "validate:renovate": "renovate-config-validator renovate.json"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "0.18.5",
    "@ddtds/vitest": "workspace:*",
    "@e18e/cli": "0.7.0",
    "@e18e/eslint-plugin": "0.8.1",
    "@logtape/lint": "catalog:dev",
    "@testing-library/react": "catalog:examples",
    "@testing-library/user-event": "catalog:examples",
    "@types/node": "catalog:dev",
    "@types/react": "catalog:examples",
    "@types/react-dom": "catalog:examples",
    "@vitest/coverage-v8": "catalog:dev",
    "happy-dom": "catalog:examples",
    "knip": "6.41.0",
    "lefthook": "2.2.2",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "publint": "0.3.25",
    "react": "catalog:examples",
    "react-dom": "catalog:examples",
    "renovate": "44.164.7",
    "sherif": "1.13.0",
    "tsdown": "0.23.1",
    "typescript": "catalog:dev",
    "unplugin-unused": "0.6.0",
    "vitest": "catalog:dev"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@12.10.1"
}
