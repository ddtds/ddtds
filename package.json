{
  "name": "ddtds",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint . --max-warnings 0",
    "lint:fix": "oxlint . --fix",
    "prebench": "pnpm run build",
    "bench": "pnpm --filter @ddtds/benches bench",
    "typecheck": "pnpm -r run typecheck",
    "build": "tsdown",
    "pretest": "pnpm run build",
    "test": "vitest run",
    "test:packages": "pnpm --filter './packages/*' run test",
    "test:examples": "pnpm --filter '@ddtds/example-*' test",
    "test:update-snapshots": "vitest run -u",
    "test:vitest": "vitest run --coverage --project '!@ddtds/node-test' --project '!@ddtds/mocha'",
    "test:node": "pnpm --filter '...@ddtds/node-test' test",
    "test:mocha": "pnpm --filter @ddtds/mocha test",
    "test:coverage": "vitest run --coverage",
    "pretest:coverage": "pnpm run build",
    "knip": "knip --treat-config-hints-as-errors",
    "publint": "pnpm --filter './packages/*' exec publint --strict",
    "sherif": "sherif --fail-on-warnings",
    "validate:renovate": "renovate-config-validator renovate.json"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "0.18.5",
    "@ddtds/vitest": "workspace:*",
    "@logtape/lint": "catalog:dev",
    "@testing-library/react": "catalog:examples",
    "@testing-library/user-event": "catalog:examples",
    "@types/node": "catalog:dev",
    "@vitest/coverage-v8": "catalog:dev",
    "happy-dom": "catalog:examples",
    "knip": "6.41.0",
    "lefthook": "2.2.1",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2003",
    "publint": "0.3.25",
    "react": "catalog:examples",
    "react-dom": "catalog:examples",
    "renovate": "44.148.4",
    "sherif": "1.13.0",
    "tsdown": "0.23.0",
    "typescript": "catalog:dev",
    "unplugin-unused": "0.6.0",
    "vitest": "catalog:dev"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@12.10.1"
}
