{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": ["dist", "**/__doctests__"],
  "env": {
    "browser": true,
    "node": true,
    "es2026": true,
    "vitest": true
  },
  "options": {
    "typeAware": true
  },
  "plugins": ["eslint", "typescript", "unicorn", "vitest", "import", "node", "promise", "oxc"],
  "jsPlugins": [{ "name": "@logtape", "specifier": "@logtape/lint/eslint" }],
  "rules": {
    "no-console": "error",
    "no-restricted-properties": [
      "error",
      { "object": "process", "property": "stdout", "message": "Use the logger." },
      { "object": "process", "property": "stderr", "message": "Use the logger." }
    ],
    "no-shadow": "off",
    "no-await-in-loop": "off",
    "@logtape/no-dynamic-message": "error",
    "@logtape/no-unrendered-properties": "error",
    "@logtape/no-message-interpolation": "error",
    "@logtape/prefer-lazy-evaluation": "error",
    "@logtape/no-unawaited-log": "error",
    "@logtape/require-meta-sink": "error",
    "typescript/no-non-null-assertion": "warn",
    "typescript/explicit-member-accessibility": "warn",
    "typescript/explicit-function-return-type": "warn",
    "import/consistent-type-specifier-style": ["warn", "prefer-top-level-if-only-type-imports"],
    "unicorn/prefer-node-protocol": "warn",
    "typescript/no-floating-promises": "warn",
    "typescript/no-misused-promises": "warn",
    "typescript/no-unnecessary-condition": "warn",
    "typescript/switch-exhaustiveness-check": "warn",
    "typescript/restrict-template-expressions": "warn",
    "typescript/no-unnecessary-type-assertion": "warn",
    "typescript/prefer-nullish-coalescing": "warn",
    "typescript/await-thenable": "warn",
    "no-duplicate-imports": "warn",
    "unicorn/prefer-array-some": "warn"
  },
  "overrides": [
    {
      "files": ["packages/mocha/src/reporter.ts", "packages/node-test/src/hooks.ts"],
      "rules": {
        "no-restricted-properties": "off",
        "typescript/no-extraneous-class": "off"
      }
    },
    {
      "files": ["**/*.test.ts"],
      "rules": {
        "typescript/no-non-null-assertion": "off",
        "typescript/explicit-function-return-type": "off"
      }
    },
    {
      "files": ["**/*.bench.ts"],
      "rules": {
        "vitest/expect-expect": "off"
      }
    }
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  }
}
