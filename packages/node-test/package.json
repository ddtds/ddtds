{
  "name": "@ddtds/node-test",
  "version": "0.0.0",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "@ddtds/source": "./src/index.ts",
      "default": "./dist/index.mjs"
    },
    "./register": {
      "@ddtds/source": "./src/register.ts",
      "default": "./dist/register.mjs"
    },
    "./runtime": {
      "@ddtds/source": "./src/runtime.ts",
      "default": "./dist/runtime.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./register": "./dist/register.mjs",
      "./runtime": "./dist/runtime.mjs",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "test": "vitest run && node --test --import @ddtds/node-test/register README.md",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@ddtds/core": "workspace:*",
    "@logtape/logtape": "catalog:prod"
  },
  "devDependencies": {
    "@ddtds/test-utils": "workspace:*",
    "@types/node": "catalog:dev",
    "typescript6": "npm:typescript@^6.0.3",
    "vitest": "catalog:dev"
  },
  "engines": {
    "node": "^24.22.0 || 25 || 26"
  }
}
